{
  "name": "map-combos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://qupersimulator.ru",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "editor": "node scripts/start-editor.mjs",
    "build": "node scripts/check-content.mjs && vite build && node scripts/prepare-hosting.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:migration": "node scripts/check-content.mjs --baseline",
    "format": "prettier --write src content scripts index.html vite.config.js",
    "format:check": "prettier --check src content scripts index.html vite.config.js",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist -b gh-pages"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.6",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "vite": "^7.2.4"
  }
}
