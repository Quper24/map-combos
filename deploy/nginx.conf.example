# Review existing sites, TLS configuration and occupied ports before enabling.
# This is an example, not an instruction to replace the current nginx.conf.
server {
    listen 80;
    server_name qupersimulator.ru www.qupersimulator.ru;
    location /.well-known/acme-challenge/ {
        root /var/www/qupersimulator/acme;
        try_files $uri =404;
    }
    location / { return 301 https://qupersimulator.ru$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name qupersimulator.ru www.qupersimulator.ru;
    ssl_certificate /etc/letsencrypt/live/qupersimulator.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qupersimulator.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /var/www/qupersimulator/site/current;
    index index.html;

    location /assets/ {
        alias /var/www/qupersimulator/site/assets/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* \.(jpg|jpeg|png|webp|svg|ico|txt|webmanifest)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=0, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}

# Configure HTTPS using the server's actual certificate setup before production.
# The profile decoder runs locally in the browser; no API proxy is required.
# Game services and ports must remain unchanged.
